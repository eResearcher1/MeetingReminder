<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:background="#016f0c"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:background="@drawable/card_background1"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:foregroundGravity="center_vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            ads:layout_constraintEnd_toEndOf="parent"
            ads:layout_constraintStart_toStartOf="parent"
            ads:layout_constraintTop_toTopOf="parent"
            ads:layout_scrollFlags="noScroll">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16sp"
                    android:gravity="center"
                    android:id="@+id/searchView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Search Your Meetings"
                    android:layout_marginStart="24dp"
                    ads:layout_constraintBottom_toBottomOf="parent"
                    ads:layout_constraintStart_toStartOf="parent"
                    ads:layout_constraintTop_toTopOf="parent"/>
                <ImageButton
                    android:id="@+id/layoutSwitchIcon"
                    android:background="?attr/selectableItemBackground"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_grid"
                    android:contentDescription="Grid"
                    android:layout_marginEnd="16dp"
                    ads:layout_constraintBottom_toBottomOf="parent"
                    ads:layout_constraintEnd_toEndOf="parent"
                    ads:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.appbar.MaterialToolbar>
        <FrameLayout
            android:background="@drawable/background_startactivity"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            ads:layout_constraintBottom_toTopOf="@+id/tabLayout"
            ads:layout_constraintEnd_toEndOf="parent"
            ads:layout_constraintStart_toStartOf="parent"
            ads:layout_constraintTop_toTopOf="parent">
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="8dp"
                android:nestedScrollingEnabled="true"
                ads:layout_behavior="@string/appbar_scrolling_view_behavior"
                ads:layout_constraintHorizontal_bias="0"
                ads:layout_constraintVertical_bias="0"/>
        </FrameLayout>
        <com.google.android.material.tabs.TabLayout
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/tabLayout"
            android:background="?attr/colorPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textAlignment="center"
            ads:layout_constraintBottom_toTopOf="@+id/adView"
            ads:layout_constraintEnd_toEndOf="parent"
            ads:layout_constraintStart_toStartOf="parent"
            ads:tabGravity="fill"
            ads:tabIndicatorAnimationMode="elastic"
            ads:tabIndicatorColor="@color/colorPrimary1"
            ads:tabIndicatorGravity="top"
            ads:tabIndicatorHeight="5dp"
            ads:tabMaxWidth="0dp"
            ads:tabSelectedTextAppearance="@style/TabTextSelectedAppearance"
            ads:tabSelectedTextColor="@color/colorPrimary1"
            ads:tabTextAppearance="@style/TabTextAppearance"
            ads:tabTextColor="#ffffff"
            style="@style/CustomTabLayout"/>
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_gravity="end|bottom"
            android:id="@+id/fab"
            android:background="@drawable/custom_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:src="@drawable/ic_add"
            android:layout_marginEnd="12dp"
            ads:backgroundTint="@color/colorPrimary"
            ads:layout_constraintBottom_toTopOf="@+id/tabLayout"
            ads:layout_constraintEnd_toEndOf="parent"/>
        <com.google.android.gms.ads.AdView
            android:id="@+id/adView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            ads:adSize="BANNER"
            ads:adUnitId="@string/real_ad"
            ads:layout_constraintBottom_toBottomOf="parent"
            ads:layout_constraintEnd_toEndOf="parent"
            ads:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.google.android.material.navigation.NavigationView
        android:layout_gravity="start"
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        ads:headerLayout="@layout/nav_header_main"
        ads:menu="@menu/drawer_menu"/>
</androidx.drawerlayout.widget.DrawerLayout>
